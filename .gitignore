# Local .terraform directories
**/.terraform/*

# .tfstate files. Every component keeps state in the azurerm backend except
# bootstrap, which creates that backend and so keeps its own locally — see README.
# Never commit it; it is recoverable by import, not by git.
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# *.tfvars files are committed intentionally (each component's terraform.tfvars
# holds its non-sensitive inputs). Do not put secrets in them; use Azure Key
# Vault, GitHub Actions secrets, or ARM_* environment variables instead.
# gitleaks (pre-commit and CI) scans every commit as a backstop.

# CLI configuration and override files
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Provider lock files ARE committed, unlike in template-terraform-root — it is a
# reusable module whose consumers generate their own locks, whereas every
# directory here is a root config, so the locks are ours to pin.

# Saved plan output
*.tfplan
